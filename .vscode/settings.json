{
    "editor.formatOnSave": true,
    "files.insertFinalNewline": true,
    "javascript.updateImportsOnFileMove.enabled": "always",
    "[javascript]": {
        "editor.defaultFormatter": "vscode.typescript-language-features"
    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.autoClosingBrackets": "always"
    },
    "[markdown]": {
        "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
    },
    // SCSS
    "[scss]": {
        "editor.defaultFormatter": "stylelint.vscode-stylelint"
    },
    // JSON
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    // Vue
    "[vue]": {
        "editor.defaultFormatter": "SimonSiefke.prettier-vscode",
    },
    // Extension: Volar
    "volar.preview.port": 3000,
    "volar.completion.preferredTagNameCase": "pascal",
    // Extension: ESLint
    "eslint.options": {
        "rulePaths": [
            "eslint-internal-rules"
        ]
    },
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit",
        "source.fixAll.stylelint": "explicit",
        "source.organizeImports": "explicit"
    },
    "eslint.alwaysShowStatus": true,
    "eslint.format.enable": true,
    "eslint.packageManager": "pnpm",
    // Extension: Stylelint
    "stylelint.packageManager": "pnpm",
    "stylelint.validate": [
        "css",
        "scss",
        "vue"
    ],
    // Extension: Spell Checker
    "cSpell.words": [
        "Composables",
        "Customizer",
        "destr",
        "flagpack",
        "Iconify",
        "ofetch",
        "psudo",
        "stylelint",
        "touchless",
        "triggerer",
        "vuetify",
        "nuxt"
    ],
    // Extension: Comment Anchors
    "commentAnchors.tags.anchors": {
        "ℹ️": {
            "scope": "hidden",
            // This color is taken from "Better Comments" Extension (?)
            "highlightColor": "#3498DB",
            "styleComment": true,
            "isItalic": false,
        },
        "👉": {
            "scope": "file",
            // This color is taken from "Better Comments" Extension (*)
            "highlightColor": "#98C379",
            "styleComment": true,
            "isItalic": false
        },
        "❗": {
            "scope": "hidden",
            // This color is taken from "Better Comments" Extension (*)
            "highlightColor": "#FF2D00",
            "styleComment": true,
            "isItalic": false,
        },
    },
    // Extension: fabiospampinato.vscode-highlight
    "highlight.regexFlags": "gi",
    "todohighlight.keywords": [
        {
            "text": "//State:",
            "isWholeLine": false,
            "color": "#61DAFB",
            "backgroundColor": "transparent",
            "border": "1px solid #61DAFB",
            "borderRadius": "4px",
            "overviewRulerColor": "grey",
        },
        {
            "text": "//Derived:",
            "isWholeLine": false,
            "color": "#a5f3fc",
            "backgroundColor": "transparent",
            "border": "1px solid #a5f3fc",
            "borderRadius": "4px",
            "overviewRulerColor": "grey",
        },
        {
            "text": "//Style:",
            "isWholeLine": false,
            "color": "#e879f9",
            "backgroundColor": "#transparent",
            "border": "1px solid #e879f9",
            "borderRadius": "4px",
            "overviewRulerColor": "grey",
        },
        {
            "text": "//Dataflow:",
            "isWholeLine": false,
            "color": "#84cc16",
            "backgroundColor": "transparent",
            "border": "1px solid #84cc16",
            "borderRadius": "4px",
            "overviewRulerColor": "grey",
        },
        {
            "text": "//Handlers:",
            "isWholeLine": false,
            "color": "#fbbf24",
            "backgroundColor": "transparent",
            "border": "1px solid #fbbf24",
            "borderRadius": "4px",
            "overviewRulerColor": "grey",
        },
        {
            "text": "//Note:",
            "isWholeLine": false,
            "color": "#2dd4bf",
            "backgroundColor": "transparent",
            "textDecoration": "underline",
            "bottomBorder": "1px solid #2dd4bf",
            "borderRadius": "4px",
            "overviewRulerColor": "gray",
        },
        {
            "text": "//Question:",
            "isWholeLine": false,
            "color": "white",
            "backgroundColor": "#7c3aed",
            "borderRadius": "4px",
            "overviewRulerColor": "grey",
        },
        {
            "text": "console.log",
            "isWholeLine": false,
            "color": "#a3e635",
            "backgroundColor": "#1e3a8a",
            "borderRadius": "4px",
            "overviewRulerColor": "grey",
        },
        {
            "isWholeLine": true,
            "text": "TODO:",
            "color": "white",
            "border": "1px solid #84cc16",
            "borderRadius": "2px", //注：borderRadiusを `border`と一緒に使うと、何も変わらないでしょう      
            "backgroundColor": "#84cc16",
            "overviewRulerColor": "#84cc16",
            //他のスタイリングのプロパティはここに書くといいよ
        }
    ],
}
